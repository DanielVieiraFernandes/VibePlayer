<Project>
  <!-- Configurações aplicadas a todos os projetos da solution (src e tests). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Warnings viram erro para que problemas apareçam no build e na CI, não em produção. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Builds reproduzíveis: o mesmo commit gera o mesmo binário em qualquer máquina. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Product>VibePlayer</Product>
    <Authors>Daniel Vieira Fernandes</Authors>
    <Copyright>Copyright © 2026 Daniel Vieira Fernandes. Todos os direitos reservados.</Copyright>
  </PropertyGroup>

  <!--
    Versão calculada pelo MinVer a partir da tag git mais próxima (vX.Y.Z), não editada à mão.
    Commit com a tag v0.1.0 → 0.1.0; commits depois dela → 0.1.1-alpha.0.N; sem tag → 0.0.0-alpha.0.N.
    As tags são criadas só pela pipeline de publicação (release.yml), então a versão de cada
    binário sempre corresponde a uma release real ou fica claramente marcada como pré-lançamento.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>
</Project>
