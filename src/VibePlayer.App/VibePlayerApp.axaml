<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VibePlayer.App.VibePlayerApp"
             RequestedThemeVariant="Default">
    <!-- "Default" segue o tema claro/escuro do sistema operacional. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://VibePlayer/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <!-- A cor de destaque do Fluent (seleção de aba, foco, slider, checkbox) segue o
                 AccentBrush do DESIGN.md, em vez da cor de destaque do Windows/macOS do usuário,
                 para o app ter a mesma identidade em qualquer sistema. -->
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#6D4AFF" />
                <ColorPaletteResources x:Key="Dark" Accent="#6D4AFF" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://VibePlayer/Styles/Controls.axaml" />
    </Application.Styles>
</Application>
