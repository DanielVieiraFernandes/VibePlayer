<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VibePlayer.App.VibePlayerApp"
             RequestedThemeVariant="Default">
    <!-- "Default" segue o tema claro/escuro do sistema operacional. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
