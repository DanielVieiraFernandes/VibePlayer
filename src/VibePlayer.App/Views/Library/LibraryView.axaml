<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:res="using:VibePlayer.App.Resources"
             xmlns:vm="using:VibePlayer.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="600"
             x:Class="VibePlayer.App.Views.Library.LibraryView"
             x:DataType="vm:LibraryViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- Ações: só aparecem com a biblioteca preenchida; vazia, o estado vazio já oferece as mesmas. -->
        <Border Classes="toolbar" IsVisible="{Binding HasCourses}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}" HorizontalAlignment="Right">
                <Button Classes="icon" Command="{Binding AddFolderCommand}"
                        AutomationProperties.Name="{x:Static res:Strings.Library_AddFolder}"
                        ToolTip.Tip="{x:Static res:Strings.Library_AddFolder}">
                    <ic:SymbolIcon Symbol="FolderAdd" />
                </Button>
                <Button Classes="icon" Command="{Binding AddVideosCommand}"
                        AutomationProperties.Name="{x:Static res:Strings.Library_AddVideos}"
                        ToolTip.Tip="{x:Static res:Strings.Library_AddVideos}">
                    <ic:SymbolIcon Symbol="VideoAdd" />
                </Button>
                <Button x:Name="RefreshButton" Classes="icon" Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="{x:Static res:Strings.Library_Refresh}"
                        ToolTip.Tip="{x:Static res:Strings.Library_Refresh}">
                    <ic:SymbolIcon Symbol="ArrowSync" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Progresso da atualização em segundo plano. -->
        <StackPanel Grid.Row="1" Margin="{StaticResource PaddingBar}" Spacing="{StaticResource SpaceXs}" IsVisible="{Binding IsRefreshing}">
            <ProgressBar IsIndeterminate="True" />
            <TextBlock x:Name="ProgressText" Classes="caption secondary" Text="{Binding ProgressText}" />
        </StackPanel>

        <!-- Faixa de erro (DESIGN.md, "Faixa de erro"). -->
        <Border Grid.Row="2" Classes="errorBanner" IsVisible="{Binding HasError}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                <ic:SymbolIcon Symbol="ErrorCircle" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Top" />
                <TextBlock x:Name="ErrorText" Grid.Column="1" Classes="body" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                <Button Grid.Column="2" Classes="icon" Command="{Binding DismissErrorCommand}" VerticalAlignment="Top"
                        AutomationProperties.Name="{x:Static res:Strings.Library_DismissError}">
                    <ic:SymbolIcon Symbol="Dismiss" FontSize="{StaticResource IconSizeSmall}" />
                </Button>
            </Grid>
        </Border>

        <!-- Biblioteca vazia. -->
        <StackPanel Grid.Row="3" Classes="emptyState" Margin="{StaticResource PaddingEmptyState}" IsVisible="{Binding !HasCourses}">
            <ic:SymbolIcon Symbol="Library" />
            <TextBlock Classes="subtitle" Text="{x:Static res:Strings.Library_EmptyTitle}" />
            <TextBlock Classes="body secondary" Text="{x:Static res:Strings.Library_EmptyDescription}" />
            <Button x:Name="EmptyAddFolderButton" Classes="primary" HorizontalAlignment="Center" Command="{Binding AddFolderCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Library_AddFolder}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                    <ic:SymbolIcon Symbol="FolderAdd" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.Library_AddFolder}" />
                </StackPanel>
            </Button>
            <Button HorizontalAlignment="Center" Command="{Binding AddVideosCommand}"
                    AutomationProperties.Name="{x:Static res:Strings.Library_AddVideos}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                    <ic:SymbolIcon Symbol="VideoAdd" />
                    <TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.Library_AddVideos}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Cursos → módulos → aulas. Cursos começam recolhidos: bibliotecas grandes continuam leves. -->
        <TreeView x:Name="Tree"
                  Grid.Row="3"
                  Classes="library"
                  ItemsSource="{Binding Courses}"
                  SelectedItem="{Binding SelectedItem}"
                  IsVisible="{Binding HasCourses}"
                  AutomationProperties.Name="{x:Static res:Strings.Library_Tree}">
            <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:LibraryItemViewModel">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="vm:LibraryItemViewModel" ItemsSource="{Binding Children}">
                    <StackPanel Classes="libraryItem">
                        <StackPanel.ContextMenu>
                            <ContextMenu IsVisible="{Binding HasActions}">
                                <MenuItem Header="{x:Static res:Strings.Library_Locate}"
                                          IsVisible="{Binding CanLocate}"
                                          Command="{Binding $parent[TreeView].((vm:LibraryViewModel)DataContext).LocateCommand}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="{x:Static res:Strings.Library_Remove}"
                                          IsVisible="{Binding CanRemove}"
                                          Command="{Binding $parent[TreeView].((vm:LibraryViewModel)DataContext).RemoveCommand}"
                                          CommandParameter="{Binding}" />
                            </ContextMenu>
                        </StackPanel.ContextMenu>
                        <TextBlock Classes="body" Classes.unavailable="{Binding !IsAvailable}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="caption secondary" Text="{Binding Caption}" IsVisible="{Binding Caption, Converter={x:Static ObjectConverters.IsNotNull}}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>

</UserControl>
