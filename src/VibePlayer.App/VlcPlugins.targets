<Project>
  <!--
    Binários do VLC distribuídos com o app (spec 0006).

    Os pacotes VideoLAN.LibVLC.* trazem o VLC inteiro: ~300 plugins, entre eles alguns com
    licença GPL (ex.: x264, goom), que o projeto não pode distribuir, e muita coisa que um player
    de arquivos locais não usa (rede, streaming, codificadores, visualizações, Lua).

    Por isso os plugins entram por LISTA DE PERMISSÃO, e não de exclusão: se uma atualização do
    VLC trouxer um plugin novo, ele fica de fora até alguém revisar a licença e incluí-lo aqui.
    A CI confere os pacotes publicados contra esta mesma lista (.github/scripts/check-vlc-plugins.sh).

    Faltou um plugin (formato que não toca)? O log do VLC acusa o módulo ausente; confira a
    licença do módulo no código do VLC antes de acrescentar.
  -->
  <PropertyGroup>
    <!-- Só a arquitetura publicada. Sem isso, um build "AnyCPU" copiaria x86, x64 e ARM64 do
         Windows (quase 1 GB). -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    <VlcAllowedPlugins>;
      libadjust_plugin;
      libadpcm_plugin;
      libadummy_plugin;
      libaes3_plugin;
      libaiff_plugin;
      libalphamask_plugin;
      libamem_plugin;
      libanaglyph_plugin;
      libantiflicker_plugin;
      libaom_plugin;
      libaraw_plugin;
      libasf_plugin;
      libau_plugin;
      libaudio_format_plugin;
      libaudiobargraph_a_plugin;
      libauhal_plugin;
      libavcodec_plugin;
      libavi_plugin;
      libball_plugin;
      libblend_plugin;
      libblendbench_plugin;
      libbluescreen_plugin;
      libcache_block_plugin;
      libcache_read_plugin;
      libcaf_plugin;
      libcanvas_plugin;
      libcaopengllayer_plugin;
      libchain_plugin;
      libchorus_flanger_plugin;
      libcolorthres_plugin;
      libcompressor_plugin;
      libcroppadd_plugin;
      libcvpx_plugin;
      libd3d11va_plugin;
      libdav1d_plugin;
      libddummy_plugin;
      libdeinterlace_plugin;
      libdirect3d11_filters_plugin;
      libdirect3d11_plugin;
      libdirect3d9_filters_plugin;
      libdirect3d9_plugin;
      libdirectsound_plugin;
      libdolby_surround_decoder_plugin;
      libdrawable_plugin;
      libdxva2_plugin;
      libedgedetection_plugin;
      libequalizer_plugin;
      liberase_plugin;
      libes_plugin;
      libextract_plugin;
      libfilesystem_plugin;
      libflac_plugin;
      libflacsys_plugin;
      libfloat_mixer_plugin;
      libfps_plugin;
      libfreeze_plugin;
      libgain_plugin;
      libgaussianblur_plugin;
      libgl_plugin;
      libglconv_cvpx_plugin;
      libglinterop_dxva2_plugin;
      libglwin32_plugin;
      libgradfun_plugin;
      libgradient_plugin;
      libgrain_plugin;
      libgrey_yuv_plugin;
      libh26x_plugin;
      libheadphone_channel_mixer_plugin;
      libhqdn3d_plugin;
      libi420_10_p010_plugin;
      libi420_nv12_plugin;
      libi420_rgb_mmx_plugin;
      libi420_rgb_plugin;
      libi420_rgb_sse2_plugin;
      libi420_yuy2_mmx_plugin;
      libi420_yuy2_plugin;
      libi420_yuy2_sse2_plugin;
      libi422_i420_plugin;
      libi422_yuy2_mmx_plugin;
      libi422_yuy2_plugin;
      libi422_yuy2_sse2_plugin;
      libidummy_plugin;
      libinflate_plugin;
      libinteger_mixer_plugin;
      libinvert_plugin;
      libkaraoke_plugin;
      liblpcm_plugin;
      libmagnify_plugin;
      libmft_plugin;
      libmirror_plugin;
      libmkv_plugin;
      libmmdevice_plugin;
      libmotionblur_plugin;
      libmotiondetect_plugin;
      libmp4_plugin;
      libmpg123_plugin;
      libmpgv_plugin;
      libnormvol_plugin;
      libogg_plugin;
      liboldmovie_plugin;
      libopus_plugin;
      libpacketizer_av1_plugin;
      libpacketizer_copy_plugin;
      libpacketizer_dirac_plugin;
      libpacketizer_dts_plugin;
      libpacketizer_flac_plugin;
      libpacketizer_h264_plugin;
      libpacketizer_hevc_plugin;
      libpacketizer_mlp_plugin;
      libpacketizer_mpeg4audio_plugin;
      libpacketizer_mpeg4video_plugin;
      libpacketizer_mpegaudio_plugin;
      libpacketizer_mpegvideo_plugin;
      libpacketizer_vc1_plugin;
      libparam_eq_plugin;
      libposterize_plugin;
      libprefetch_plugin;
      libps_plugin;
      libpsychedelic_plugin;
      libpuzzle_plugin;
      librawvideo_plugin;
      libremap_plugin;
      libripple_plugin;
      librv32_plugin;
      libscale_plugin;
      libscaletempo_pitch_plugin;
      libscaletempo_plugin;
      libscene_plugin;
      libsepia_plugin;
      libsharpen_plugin;
      libsimple_channel_mixer_plugin;
      libskiptags_plugin;
      libspatialaudio_plugin;
      libspatializer_plugin;
      libspeex_plugin;
      libspeex_resampler_plugin;
      libstereo_widen_plugin;
      libstream_out_smem_plugin;
      libstream_out_transcode_plugin;
      libswscale_plugin;
      libtheora_plugin;
      libtospdif_plugin;
      libtransform_plugin;
      libtrivial_channel_mixer_plugin;
      libts_plugin;
      libugly_resampler_plugin;
      libvc1_plugin;
      libvdummy_plugin;
      libvhs_plugin;
      libvideotoolbox_plugin;
      libvmem_plugin;
      libvorbis_plugin;
      libvout_macosx_plugin;
      libvpx_plugin;
      libwasapi_plugin;
      libwav_plugin;
      libwave_plugin;
      libwgl_plugin;
      libwingdi_plugin;
      libwinhibit_plugin;
      libyuvp_plugin;
      libyuy2_i420_plugin;
      libyuy2_i422_plugin;
    </VlcAllowedPlugins>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sem lua\ (scripts de interface e de sites de vídeo, que o app não usa). -->
    <VlcWindowsX64IncludeFiles Include="libvlc.%2A;libvlccore.%2A;hrtfs\%2A%2A;plugins\%2A%2A" />
  </ItemGroup>

  <!--
    Tira do Content os plugins fora da lista e a pasta lua. Roda depois que os pacotes do VLC
    adicionaram seus arquivos (Windows num target, macOS na avaliação) e antes de o SDK decidir o
    que copiar.
  -->
  <Target Name="FilterVlcPlugins" AfterTargets="CollectVlcFilesToCopyWindows" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <_VlcAllowedPluginsCompact>$(VlcAllowedPlugins.Replace(' ', '').Replace('%0D', '').Replace('%0A', ''))</_VlcAllowedPluginsCompact>
    </PropertyGroup>
    <ItemGroup>
      <_VlcContent Include="@(Content)" Condition="$([System.String]::Copy('%(Content.Link)').Replace('/', '\').StartsWith('libvlc\'))" />
      <_VlcRejected Include="@(_VlcContent)"
                    Condition="$([System.String]::Copy('%(_VlcContent.Link)').Replace('/', '\').Contains('\plugins\')) And !$(_VlcAllowedPluginsCompact.Contains(';%(_VlcContent.Filename);'))" />
      <_VlcRejected Include="@(_VlcContent)"
                    Condition="$([System.String]::Copy('%(_VlcContent.Link)').Replace('/', '\').Contains('\lua\'))" />
      <Content Remove="@(_VlcRejected)" />
    </ItemGroup>
  </Target>
</Project>
