<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Os quadros do VLC chegam por ponteiros nativos (Playback/VlcFrameBuffer). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VibePlayer.Core\VibePlayer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="LibVLCSharp" />
    <PackageReference Include="SkiaSharp" />
    <!-- PrivateAssets: o pacote de design só serve ao dotnet ef e não deve vazar para o App. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
</Project>
